{
  "$schema": "../schemas/component/v1.schema.json",
  "components": [
    {
      "name": "Button",
      "description": "A control that starts an action, named by its label.",
      "tokens": ["component.button.base"],
      "variants": {
        "destructive": [false, true],
        "emphasis": ["high", "medium", "low"],
        "size": ["sm", "md", "lg"]
      },
      "states": ["enabled", "hovered", "pressed", "focused", "disabled"],
      "content": {
        "type": "parts",
        "slots": {
          "label": {
            "required": false,
            "for": "ButtonLabel"
          },
          "icon": {
            "required": false,
            "for": ["ButtonIcon", "*"]
          },
          "spinner": {
            "required": false,
            "for": "ButtonSpinner",
            "placement": "overlay"
          }
        }
      },
      "layout": {
        "type": "flow",
        "direction": "row",
        "justify": "center",
        "align": "center"
      }
    },
    {
      "name": "ButtonIcon",
      "description": "The icon a button carries beside its label.",
      "content": "illustration",
      "tokens": ["component.button.icon"]
    },
    {
      "name": "ButtonLabel",
      "description": "The text that names the action.",
      "content": "text",
      "tokens": ["component.button.label"]
    },
    {
      "name": "ButtonSpinner",
      "description": "The busy mark shown while the action runs.",
      "content": {
        "type": "illustration",
        "name": "Spinner"
      },
      "tokens": ["component.button.spinner"]
    }
  ]
}
